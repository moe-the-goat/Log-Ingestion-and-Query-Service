# Every value below is optional. `docker compose up` works with none of them set.

# HOST=0.0.0.0
# PORT=8080
# LOG_LEVEL=info
# HTTP_MAX_BODY_BYTES=4194304

# DATABASE_URL=postgres://logs:logs@localhost:5432/logs
# DATABASE_POOL_SIZE=8
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Write path: binary copy, text copy, or multi-row insert. Text and insert exist for comparison.
# INGEST_WRITER=binary
# INGEST_FLUSH_INTERVAL_MS=50
# INGEST_FLUSH_MAX_BYTES=8388608
# INGEST_QUEUE_MAX_BYTES=67108864
# INGEST_MAX_CONCURRENT_FLUSHES=4

# Partitions older than RETENTION_DAYS are dropped whole.
# PARTITION_AHEAD_DAYS=3
# RETENTION_DAYS=30
# MAINTENANCE_INTERVAL_MS=3600000
